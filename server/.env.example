# HarnessRouter Cloud API Key — 从 HarnessRouter 控制台获取
HARNESSROUTER_API_KEY=your-harnessrouter-api-key-here

# HarnessRouter Cloud API base URL (optional, defaults to https://api.harnessrouter.ai)
# HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai

# Server port (optional, defaults to 3001)
# PORT=3001

# Provider API key for model inference (BYOK)
# HarnessRouter free trial covers agent work and memory; model usage requires your own provider key.
# The OPENROUTER_API_KEY is configured in the harness env on HarnessRouter Cloud, not in this .env file.
# Add it through the HarnessRouter API: PUT /v1/harnesses/{harness_id} with env: { "OPENROUTER_API_KEY": "sk-or-..." }
# Note: HarnessRouter models use paid OpenRouter endpoints; ensure your OpenRouter account has credits.
